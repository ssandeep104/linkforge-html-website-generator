{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": ".",
  "routes": [
    { "src": "/style\\.css", "dest": "/neo-tech-production.css" },
    { "handle": "filesystem" },
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer"
      },
      "dest": "/$1"
    }
  ]
}
