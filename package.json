{
  "name": "linkforge",
  "version": "1.0.0",
  "private": true,
  "description": "Client-side HTML aggregator. Drop in HTML from any source, get a styled standalone HTML page.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "echo 'Static app, no build step required'",
    "start": "node server.js",
    "lint": "echo 'No linting required'",
    "test": "node --test tests/*.test.js tests/**/*.test.js",
    "test:golden:update": "node tests/generate-golden.mjs"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
